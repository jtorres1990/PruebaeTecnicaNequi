  </diagram>

  <diagram id="payment-expiration-race" name="06 - Consistencia y concurrencia">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="r-header" value="CONSISTENCIA BAJO CONCURRENCIA · PAGO CONTRA EXPIRACIÓN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=left;spacingLeft=30;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="70" as="geometry"/></mxCell>
        <mxCell id="r-sub" value="La Order en CREATED es el guardián único: la primera transición terminal que confirma su condición gana" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#486579;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1200" height="30" as="geometry"/></mxCell>

        <mxCell id="r-initial" value="ESTADO COMPARTIDO&#xa;Order = CREATED&#xa;expiresAt = T&#xa;Tickets = RESERVED o PENDING_CONFIRMATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="135" width="400" height="115" as="geometry"/></mxCell>

        <mxCell id="r-pay-lane" value="RUTA DE PAGO" style="swimlane;horizontal=1;startSize=38;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE8CF;swimlaneFillColor=#FFFBF6;strokeColor=#D98A35;fontColor=#57310E;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="560" height="340" as="geometry"/></mxCell>
        <mxCell id="r-pay-start" value="Worker recibe resultado APPROVED&#xa;para paymentAttemptId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D98A35;fontColor=#57310E;fontSize=14;" vertex="1" parent="1"><mxGeometry x="135" y="380" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="r-pay-condition" value="TX Confirmar&#xa;Order.status = CREATED&#xa;expiresAt &gt; ahora&#xa;PaymentAttempt coincide" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1DF;strokeColor=#C8751F;fontColor=#57310E;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="365" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="r-pay-note" value="Cada Ticket debe pertenecer a la Order y estar en PENDING_CONFIRMATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D98A35;fontColor=#57310E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="525" width="380" height="70" as="geometry"/></mxCell>

        <mxCell id="r-exp-lane" value="RUTA DE EXPIRACIÓN" style="swimlane;horizontal=1;startSize=38;rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;swimlaneFillColor=#F7FBFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="300" width="560" height="340" as="geometry"/></mxCell>
        <mxCell id="r-exp-start" value="Proceso periódico encuentra Order&#xa;en GSI3 · RESV# · expiresAt ≤ ahora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1255" y="380" width="210" height="85" as="geometry"/></mxCell>
        <mxCell id="r-exp-condition" value="TX Expirar&#xa;Order.status = CREATED&#xa;expiresAt ≤ ahora&#xa;sin cuarentena" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#2D78A8;fontColor=#12324A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1005" y="365" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="r-exp-note" value="Libera Ticket y marca reverso si el pago pudo quedar aprobado o desconocido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="525" width="380" height="70" as="geometry"/></mxCell>

        <mxCell id="r-guard" value="TRANSACCIÓN CONDICIONAL&#xa;solo un commit puede observar CREATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;strokeWidth=2;fontColor=#762B24;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="665" y="370" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="r-win" value="PRIMER COMMIT&#xa;realiza la transición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4E7;strokeColor=#4E9367;fontColor=#163E25;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="520" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="r-lose" value="SEGUNDO INTENTO&#xa;falla condición · relee Order&#xa;y no vuelve a transicionar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=#7B8B95;fontColor=#2D414E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="690" y="625" width="220" height="85" as="geometry"/></mxCell>

        <mxCell id="r-confirmed" value="GANA PAGO&#xa;Order CONFIRMED&#xa;Ticket SOLD&#xa;bloqueo eliminado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4E7;strokeColor=#4E9367;fontColor=#163E25;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="715" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="r-expired" value="GANA EXPIRACIÓN&#xa;Order EXPIRED&#xa;Ticket AVAILABLE&#xa;reverso si aplica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="715" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="r-late" value="APROBACIÓN TARDÍA&#xa;nunca reabre la Order&#xa;audita y asegura cancelación idempotente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EDFA;strokeColor=#8064A2;fontColor=#46315E;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="635" y="760" width="330" height="90" as="geometry"/></mxCell>

        <mxCell id="r-e1" value="compiten" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C8751F;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="r-pay-condition" target="r-guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e2" value="compiten" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D78A8;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="r-exp-condition" target="r-guard"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e3" value="éxito" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4E9367;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="r-guard" target="r-win"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-e4" value="condición ya no cumple" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#7B8B95;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="935" y="420" as="sourcePoint"/><Array as="points"><mxPoint x="940" y="420"/><mxPoint x="940" y="667"/></Array><mxPoint x="910" y="667" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4E9367;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="590" as="sourcePoint"/><Array as="points"><mxPoint x="760" y="675"/><mxPoint x="320" y="675"/></Array><mxPoint x="320" y="715" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D78A8;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="840" y="590" as="sourcePoint"/><Array as="points"><mxPoint x="840" y="690"/><mxPoint x="1280" y="690"/></Array><mxPoint x="1280" y="715" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="r-e7" value="aprobación tardía" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#8064A2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="805" as="sourcePoint"/><mxPoint x="965" y="805" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="dynamodb-model" name="07 - Modelo DynamoDB">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="d-header" value="MODELO DYNAMODB · PARTICIONES E ÍNDICES DISPERSOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=left;spacingLeft=30;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="70" as="geometry"/></mxCell>
        <mxCell id="d-sub" value="El Ticket es la unidad de competencia; cada Ticket usa una partition key propia y la disponibilidad se distribuye entre shards" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#486579;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1250" height="30" as="geometry"/></mxCell>

        <mxCell id="d-table" value="TABLA ÚNICA · ticketing · PK / SK" style="swimlane;horizontal=1;startSize=40;rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4E7;swimlaneFillColor=#F8FCFA;strokeColor=#5A9D72;fontColor=#163E25;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="135" width="890" height="600" as="geometry"/></mxCell>
        <mxCell id="d-event" value="EVENT&#xa;PK = EVENT#evt-123&#xa;SK = #META&#xa;capacity=50.000 · availabilityShards=25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4E9367;fontColor=#163E25;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="215" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="d-ticket1" value="TICKET A&#xa;PK = TICKET#evt-123#VIP-A-0001&#xa;SK = #META&#xa;state = AVAILABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#2D78A8;fontColor=#12324A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="205" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="d-ticket2" value="TICKET B&#xa;PK = TICKET#evt-123#VIP-A-0002&#xa;SK = #META&#xa;state = AVAILABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#2D78A8;fontColor=#12324A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="640" y="205" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="d-partition-note" value="Partition keys diferentes → compras de tickets distintos no compiten por un único item Event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="345" width="490" height="65" as="geometry"/></mxCell>
        <mxCell id="d-order" value="ORDER + RESERVATION + PAYMENT ATTEMPT&#xa;PK = ORDER#ord-456 · SK = #META&#xa;status = CREATED · expiresAt · enqueuedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1DF;strokeColor=#D98A35;fontColor=#57310E;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="455" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="d-idem" value="IDEMPOTENCIA&#xa;PK = IDEM#customer#key&#xa;TTL mínimo 24 h" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A9D72;fontColor=#163E25;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405" y="455" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="d-lock" value="BLOQUEO ACTIVO&#xa;PK = ACTIVE#customer#event&#xa;una Order activa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A9D72;fontColor=#163E25;fontSize=13;" vertex="1" parent="1"><mxGeometry x="650" y="455" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="d-audit" value="AUDITORÍA APPEND-ONLY&#xa;PK = ORDER#ord-456&#xa;SK = AUDIT#instant#code#suffix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A9D72;fontColor=#163E25;fontSize=13;" vertex="1" parent="1"><mxGeometry x="75" y="600" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="d-tx" value="RESERVA ATÓMICA · TransactWriteItems&#xa;N Ticket + Order + Idempotencia + Auditoría + Bloqueo = N + 4&#xa;máximo 10 Ticket → 14 items · all-or-nothing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163E25;strokeColor=#163E25;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="405" y="595" width="465" height="100" as="geometry"/></mxCell>

        <mxCell id="d-indexes" value="ÍNDICES SECUNDARIOS DISPERSOS" style="swimlane;horizontal=1;startSize=40;rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;swimlaneFillColor=#F7FBFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="975" y="135" width="585" height="600" as="geometry"/></mxCell>
        <mxCell id="d-gsi1" value="GSI1 · CICLO DEL EVENT&#xa;EVENTS#PROVISIONING / ENABLED / FAILED&#xa;listar y detectar aprovisionamientos estancados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1020" y="210" width="495" height="90" as="geometry"/></mxCell>
        <mxCell id="d-gsi2" value="GSI2 · DISPONIBILIDAD&#xa;PK = AVAIL#eventId#shard&#xa;SK = section#row#seat&#xa;solo Ticket AVAILABLE · proyección de ubicación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#2D78A8;fontColor=#12324A;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="495" height="115" as="geometry"/></mxCell>
        <mxCell id="d-gsi3" value="GSI3 · ÍNDICE DE TRABAJO&#xa;RESV#8 shards → expiración&#xa;REVERSAL#4 shards → cancelaciones&#xa;REVIEW#QUARANTINE → revisión manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1DF;strokeColor=#D98A35;fontColor=#57310E;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1020" y="475" width="495" height="110" as="geometry"/></mxCell>
        <mxCell id="d-gsi4" value="GSI4 · PENDIENTES DE ENCOLADO&#xa;PK = PENDQ#shard · 8 shards&#xa;SK = createdAtMs#orderId · proyección KEYS_ONLY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;fontColor=#762B24;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1020" y="615" width="495" height="80" as="geometry"/></mxCell>

        <mxCell id="d-shard" value="availabilityShards = min(32, max(1, ceil(capacity / 2.000)))&#xa;50.000 Ticket → 25 shards · hash(ticketId) mod 25" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="775" width="840" height="65" as="geometry"/></mxCell>
        <mxCell id="d-trade" value="Trade-off: más escrituras de índice y lecturas por shard a cambio de evitar particiones calientes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=#7B8B95;fontColor=#2D414E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1245" y="775" width="315" height="65" as="geometry"/></mxCell>

        <mxCell id="d-e1" value="AVAILABLE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D78A8;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="260" as="sourcePoint"/><Array as="points"><mxPoint x="950" y="260"/><mxPoint x="950" y="390"/></Array><mxPoint x="1020" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="d-e2" value="RESV#" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#D98A35;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="500" as="sourcePoint"/><Array as="points"><mxPoint x="390" y="500"/><mxPoint x="390" y="715"/><mxPoint x="950" y="715"/><mxPoint x="950" y="530"/></Array><mxPoint x="1020" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="d-e3" value="PENDQ# hasta enqueuedAt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#C95D50;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="375" y="535" as="sourcePoint"/><Array as="points"><mxPoint x="397" y="535"/><mxPoint x="397" y="750"/><mxPoint x="965" y="750"/><mxPoint x="965" y="655"/></Array><mxPoint x="1020" y="655" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="enqueue-recovery" name="08 - Recuperación ante fallos">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="f-header" value="RECUPERACIÓN ANTE FALLO DE PUBLICACIÓN · ADR-026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=left;spacingLeft=30;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="70" as="geometry"/></mxCell>
        <mxCell id="f-sub" value="DynamoDB y SQS no comparten transacción: compensación síncrona, GSI4 y expiración cierran la ventana" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=15;fontColor=#486579;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1200" height="30" as="geometry"/></mxCell>

        <mxCell id="f-request" value="Solicitud de compra&#xa;Idempotency-Key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6E8798;fontColor=#18384E;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="220" width="180" height="80" as="geometry"/></mxCell>
        <mxCell id="f-circuit" value="¿Circuit breaker de&#xa;publicación abierto?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;fontColor=#762B24;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="275" y="200" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="f-503-pre" value="503 + Retry-After&#xa;sin reservar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;fontColor=#762B24;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="380" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="f-reserve" value="TX RESERVA&#xa;Order CREATED · Ticket RESERVED&#xa;Order entra en GSI4 PENDQ#" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4E7;strokeColor=#4E9367;fontColor=#163E25;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="205" width="255" height="110" as="geometry"/></mxCell>
        <mxCell id="f-publish" value="PUBLICACIÓN MSG-001&#xa;timeout 500 ms por intento&#xa;máximo 3 intentos + jitter&#xa;presupuesto total 2 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1DF;strokeColor=#D98A35;fontColor=#57310E;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="835" y="195" width="235" height="130" as="geometry"/></mxCell>
        <mxCell id="f-delivered" value="¿Publicación&#xa;confirmada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1DF;strokeColor=#C8751F;fontColor=#57310E;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="200" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="f-success" value="Marca enqueuedAt&#xa;sale de GSI4&#xa;201 · CREATED + orderId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4E7;strokeColor=#4E9367;fontColor=#163E25;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="205" width="195" height="110" as="geometry"/></mxCell>

        <mxCell id="f-compensate" value="TX COMPENSACIÓN&#xa;Order → FAILED&#xa;Ticket → AVAILABLE&#xa;elimina bloqueo y GSI4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;fontColor=#762B24;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1095" y="405" width="240" height="125" as="geometry"/></mxCell>
        <mxCell id="f-comp-ok" value="¿Compensación&#xa;confirmada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;fontColor=#762B24;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1410" y="410" width="150" height="115" as="geometry"/></mxCell>
        <mxCell id="f-failed-result" value="201 · FAILED + orderId&#xa;PROCESSING_UNAVAILABLE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=#7B8B95;fontColor=#2D414E;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1370" y="600" width="190" height="75" as="geometry"/></mxCell>

        <mxCell id="f-gap" value="VENTANA NO RESUELTA&#xa;caída entre commit y publicación&#xa;o doble fallo publicación + compensación&#xa;Order sigue CREATED sin enqueuedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#C95D50;strokeWidth=2;fontColor=#762B24;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="575" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="f-gsi4" value="GSI4 · PENDQ#0..7&#xa;solo Orders CREATED&#xa;sin enqueuedAt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="585" width="245" height="100" as="geometry"/></mxCell>
        <mxCell id="f-sweep" value="CMP-023 · BARRIDO&#xa;cada 10 s · consulta 8 shards&#xa;createdAt &lt; ahora − 30 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEFF;strokeColor=#4B93C4;fontColor=#12324A;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="175" y="580" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="f-time" value="¿Quedan al menos&#xa;15 s antes de expiresAt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF5FF;strokeColor=#2D78A8;fontColor=#12324A;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="215" y="735" width="170" height="105" as="geometry"/></mxCell>
        <mxCell id="f-republish" value="Republica MSG-001&#xa;y marca enqueuedAt&#xa;duplicado tolerado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF4E7;strokeColor=#4E9367;fontColor=#163E25;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="745" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="f-expire" value="No republica&#xa;la expiración cierra la Order&#xa;y libera los Ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF1F3;strokeColor=#7B8B95;fontColor=#2D414E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="45" y="745" width="160" height="85" as="geometry"/></mxCell>
        <mxCell id="f-last" value="Última garantía: ninguna reserva queda indefinida" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="770" width="400" height="50" as="geometry"/></mxCell>

