        <mxCell id="s-e6" value="6 · marca enqueuedAt" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9367;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="515" as="sourcePoint"/><mxPoint x="645" y="515" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-e7" value="7 · 201 CREATED + orderId" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#2D78A8;strokeWidth=2;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="560" as="sourcePoint"/><mxPoint x="120" y="560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-e8" value="8 · recibe MSG-001 · at-least-once" style="endArrow=block;endFill=1;html=1;strokeColor=#C8751F;strokeWidth=2;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="910" y="605" as="sourcePoint"/><mxPoint x="1175" y="605" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-e9" value="9 · TX inicio de pago · N + 2" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9367;strokeWidth=2;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="650" as="sourcePoint"/><mxPoint x="645" y="650" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-e10" value="10 · authorize(paymentAttemptId)" style="endArrow=block;endFill=1;html=1;strokeColor=#8064A2;strokeWidth=2;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="695" as="sourcePoint"/><mxPoint x="1460" y="695" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-e11" value="11 · APPROVED" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#8064A2;fontSize=13;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1460" y="735" as="sourcePoint"/><mxPoint x="1175" y="735" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-e12" value="12 · TX confirma · N + 3 · Order CONFIRMED + Ticket SOLD" style="endArrow=block;endFill=1;html=1;strokeColor=#4E9367;strokeWidth=3;fontSize=13;fontStyle=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1175" y="785" as="sourcePoint"/><mxPoint x="645" y="785" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="s-legend" value="Tres fronteras transaccionales: reserva · inicio de pago · confirmación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12324A;strokeColor=#12324A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="465" y="835" width="670" height="40" as="geometry"/></mxCell>
